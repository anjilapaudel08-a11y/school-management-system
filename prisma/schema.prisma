// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  BOARD_MEMBER
}

model School {
  id              String  @id @default(cuid())
  name            String
  shortName       String?
  address         String?
  phone           String?
  email           String?
  website         String?
  establishedYear Int?
  description     String?
  logo            String?
  coverImage      String?

  infrastructure Infrastructure[]
  academicYears  AcademicYear[]
  classes        Class[]
  sections       Section[]
  students       Student[]
  teachers       Teacher[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id       String   @id @default(cuid())
  name     String
  email    String   @unique
  password String
  role     UserRole @default(BOARD_MEMBER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Infrastructure {
  id          String  @id @default(cuid())
  schoolId    String
  name        String
  description String?
  image       String?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]

  terms              AcademicTerm[]
  teacherAssignments TeacherAssignment[]
  classSubjects      ClassSubject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Class {
  id       String @id @default(cuid())
  schoolId String
  name     String
  order    Int

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]

  subjects           ClassSubject[]
  teacherAssignments TeacherAssignment[]
  exams              Exam[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Section {
  id       String @id @default(cuid())
  schoolId String
  name     String

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Student {
  id              String    @id @default(cuid())
  schoolId        String
  admissionNumber String
  firstName       String
  middleName      String?
  lastName        String?
  dateOfBirth     DateTime?
  gender          String?
  address         String?
  phone           String?
  email           String?
  fatherName      String?
  motherName      String?
  guardianName    String?
  guardianPhone   String?
  photo           String?

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]

  marks Mark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
}

model Teacher {
  id          String    @id @default(cuid())
  schoolId    String
  firstName   String
  middleName  String?
  lastName    String?
  dateOfBirth DateTime?
  gender      String?
  address     String?
  phone       String?
  email       String?
  position    String?
  joiningDate DateTime?
  basicSalary Decimal?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  assignments TeacherAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model Enrollment {
  id             String  @id @default(cuid())
  studentId      String
  academicYearId String
  classId        String
  sectionId      String?
  rollNumber     Int?

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  section      Section?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, academicYearId])
  @@index([academicYearId])
  @@index([classId])
  @@index([sectionId])
}

model Subject {
  id          String  @id @default(cuid())
  name        String
  code        String?
  description String?

  classSubjects      ClassSubject[]
  examSubjects       ExamSubject[]
  teacherAssignments TeacherAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
}

model ClassSubject {
  id             String @id @default(cuid())
  classId        String
  subjectId      String
  academicYearId String

  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, subjectId, academicYearId])
  @@index([classId])
  @@index([subjectId])
}

model AcademicTerm {
  id             String @id @default(cuid())
  academicYearId String
  name           String
  order          Int

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  exams        Exam[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicYearId, order])
  @@unique([academicYearId, name])
  @@index([academicYearId])
}

model Exam {
  id        String    @id @default(cuid())
  termId    String
  classId   String
  name      String
  startDate DateTime?
  endDate   DateTime?

  term     AcademicTerm  @relation(fields: [termId], references: [id], onDelete: Cascade)
  class    Class         @relation(fields: [classId], references: [id], onDelete: Restrict)
  subjects ExamSubject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([termId])
  @@index([classId])
}

model ExamSubject {
  id        String @id @default(cuid())
  examId    String
  subjectId String

  theoryFullMarks    Decimal @db.Decimal(6, 2)
  practicalFullMarks Decimal @db.Decimal(6, 2)

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  marks Mark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, subjectId])
  @@index([examId])
  @@index([subjectId])
}

model Mark {
  id            String @id @default(cuid())
  examSubjectId String
  studentId     String

  theoryMarks    Decimal @db.Decimal(6, 2)
  practicalMarks Decimal @db.Decimal(6, 2)

  examSubject ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examSubjectId, studentId])
  @@index([studentId])
  @@index([examSubjectId])
}

model GradeScale {
  id          String  @id @default(cuid())
  name        String
  description String?

  entries GradeScaleEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GradeScaleEntry {
  id           String @id @default(cuid())
  gradeScaleId String

  minPercentage Decimal @db.Decimal(5, 2)
  maxPercentage Decimal @db.Decimal(5, 2)
  grade         String
  gradePoint    Decimal @db.Decimal(4, 2)

  gradeScale GradeScale @relation(fields: [gradeScaleId], references: [id], onDelete: Cascade)

  @@index([gradeScaleId])
}

model TeacherAssignment {
  id             String @id @default(cuid())
  teacherId      String
  classId        String
  subjectId      String
  academicYearId String

  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, classId, subjectId, academicYearId])
  @@index([teacherId])
  @@index([classId])
  @@index([subjectId])
  @@index([academicYearId])
}
